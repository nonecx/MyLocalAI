# ============================================================
# MyLocalAI 环境变量样例
# 用法：复制本文件为 .env（同目录），填入真实密钥。.env 已被 .gitignore 排除，勿提交。
#       PowerShell:  Copy-Item .env.example .env
#       Git Bash:    cp .env.example .env
# 所有变量都是"环境变量优先、其次 .env、最后内置默认值"。
# ============================================================

# ---- 主提供方 ----
# 可选 longcat / deepseek / openai。密钥、接口地址、模型名三项**按提供方成组绑定**：
# 换供应商只改这一项即可，不会出现"换了密钥、请求还发往旧家"的静默错配。
# 提供方表本身在 shared_core/providers.json：加一家新的提供方只需在那里加一段
# （或写进 LLM_PROVIDERS_EXTRA_PATH 指向的增量文件），再到本文件配它自己的三项。
LLM_PROVIDER=longcat

# ---- 备用链路（可选）----
# 逗号分隔的备用提供方。主提供方调用失败时按顺序尝试；各家必须有各自的密钥才生效。
# 例：主用 LongCat、失败时退到 OpenAI →  LLM_FALLBACKS=openai
LLM_FALLBACKS=

# ---- LongCat（默认提供方）----
# 密钥在 https://longcat.chat 控制台获取。服务端注册模型名是 LongCat-2.5-Preview
# （英文连字符，写成中文"预览"会 400）。
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.5-Preview

# ---- DeepSeek（可选，LLM_PROVIDER=deepseek 时使用）----
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ---- OpenAI（可选，LLM_PROVIDER=openai 时使用）----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- 超时与重试（可选，有内置默认值）----
# 单次 HTTP 尝试的最长等待秒数（默认 30）。注意这**不是**一次分析的总时长，
# 总时长由下面的预算控制。
LLM_TIMEOUT_S=30
# 单次调用的重试次数（默认 1，即最多 2 次尝试）。原默认跟随 openai 库是 2（最多 3 次），
# 叠加"关闭思维链参数失败再回落一次"会把一次逻辑调用放大到 6 个 HTTP 请求。
LLM_MAX_RETRIES=1
# 单次尝试超时的下限（默认 0.25）。原先写死 1.0s：预算只剩 0.2s 时仍会发一次完整尝试，
# 让整条链路超出预算。设为更小的值可以让预算更紧，但过小会让窄窗口内的尝试更容易失败。
LLM_MIN_ATTEMPT_S=0.25

# ---- 请求级时长预算（可选）----
# 一次 classic 分析（core_judge.judge 全链路）的总预算秒数，默认 120；<=0 表示不限。
# 上游不可达时，原先要串行等 4 个模块 × 多次重试（实测最差 515.8 秒）；设了预算后
# 每次调用的等待不超过剩余预算，用尽即快速降级返回。
JUDGE_DEADLINE_S=120

# ---- 进程内结果缓存（可选）----
# 上游模型在 temperature=0 下仍有采样漂移、且不认 seed（实测同 seed 6 次调用得到 5 种输出），
# 因此"同一段文本重复分析给出不同结论"靠缓存消除：同样的请求在进程内只真正调用一次。
# TTL 秒数与条数上限；LLM_CACHE_MAX=0 即关闭缓存。
LLM_CACHE_TTL_S=900
LLM_CACHE_MAX=256

# ---- 报告生成模式（可选，2026-10-24 修复 F2）----
# 默认（llm）走第 4 次大模型调用生成报告：temperature=0，且与核心裁判结论做一致性
# 校验，不一致自动回退本地模板。设为 template 则完全跳过这次调用、直接出本地模板
# （一次 classic 分析从 4 次 LLM 调用降到 3 次）。
# REPORT_MODE=llm

# ---- 检索后端（可选，仅谣言 Agent 联网取证用）----
# 默认 360 搜索 + 百度。用专用 JSON 搜索 API 时填下面三项，格式约定
# {"results":[{"title","url","snippet","date"}]}。
RUMOR_SEARCH_BACKENDS=so360,baidu
# RUMOR_SEARCH_API_URL=
# RUMOR_SEARCH_API_KEY=
# RUMOR_SEARCH_API_NAME=

# ---- 提供方表 / 提示词的替代文件（可选，2026-10-22 修复 G4/G8）----
# 默认读 shared_core/providers.json 与 rumor_agent/prompts.json。
# _PATH 指向完整替代文件；_EXTRA_PATH 指向只含增量条目的文件（深合并覆盖/列表取并集）。
# LLM_PROVIDERS_PATH=
# LLM_PROVIDERS_EXTRA_PATH=
# RUMOR_PROMPTS_PATH=
# RUMOR_PROMPTS_EXTRA_PATH=

# ---- 网站进程数（可选）----
# 多进程部署（uvicorn --workers N）时显式填 N，启动会给出"缓存与历史各自独立"的告警。
# 不填也能跑，只是少一条提醒；也可用响应里的 cache_instance 字段观察。
# APP_WORKERS=1

# ---- 判定口径与信源名单的替代文件（可选）----
# 默认读 rumor_agent/verdict_rules.json 与 rumor_agent/sources_registry.json。
# _PATH 指向完整替代文件；_EXTRA_PATH 指向只含增量条目的文件（深合并覆盖/列表取并集）。
# 换行业把信源档位重命名时，除了 tiers 还要改 sources_registry.json 里的
# reliable_tiers / fetch_tiers / link_tiers / channel_score（按档名声明，不必改 Python）。
# 已知结构写坏（类型不对）会退回内置默认并留告警（rules.load_warnings()），不崩、
# 也不会把官方来源静默降级。
# RUMOR_RULES_PATH=
# RUMOR_RULES_EXTRA_PATH=
# RUMOR_SOURCES_PATH=
# RUMOR_SOURCES_EXTRA_PATH=
